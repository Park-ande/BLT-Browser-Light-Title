{
  "name": "BLT",
  "version": "1.0.0",
  "description": "BLT: Lightweight browser overlay titler with custom plate images",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "build:win": "node scripts-build-win.js",
    "build:mac": "node scripts-build-mac.js",
    "build": "node -e \"process.platform === 'win32' ? require('child_process').execSync('node scripts-build-win.js', {stdio:'inherit'}) : require('child_process').execSync('node scripts-build-mac.js', {stdio:'inherit'})\""
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "express": "^4.22.2",
    "multer": "^2.3.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pe-library": "^2.0.1",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0"
  }
}